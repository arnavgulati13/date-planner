# Copy this file to .env and paste in your own keys. Never share .env or put keys in chat.
# The model and other switches live in config.json, not here.

# Required for real AI: https://console.anthropic.com -> API keys
ANTHROPIC_API_KEY=

# Optional: live venue search (Google Cloud, with "Places API (New)" enabled).
# Leave blank to use ~30 sample Chicago venues instead.
GOOGLE_MAPS_API_KEY=
